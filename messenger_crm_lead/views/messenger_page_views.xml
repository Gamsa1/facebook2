<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="messenger_page_view_list" model="ir.ui.view">
        <field name="name">messenger.page.view.list</field>
        <field name="model">messenger.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="page_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="messenger_page_view_form" model="ir.ui.view">
        <field name="name">messenger.page.view.form</field>
        <field name="model">messenger.page</field>
        <field name="arch" type="xml">
            <form string="Facebook/Instagram Page">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Asp Construction"/>
                        </h1>
                    </div>
                    <group>
                        <field name="page_id" string="Facebook Page ID"/>
                        <field name="page_access_token" password="True"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────────── -->
    <record id="messenger_page_view_search" model="ir.ui.view">
        <field name="name">messenger.page.view.search</field>
        <field name="model">messenger.page</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="page_id"/>
                <filter string="Active" name="active" domain="[('active','=',True)]"/>
                <filter string="Archived" name="inactive" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────── -->
    <record id="messenger_page_action" model="ir.actions.act_window">
        <field name="name">Messenger Pages</field>
        <field name="res_model">messenger.page</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="messenger_page_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Pages configured yet!
            </p>
            <p>
                Add a Facebook Page here with its Page ID and Access Token to start
                receiving Messenger conversations.
            </p>
        </field>
    </record>

</odoo>